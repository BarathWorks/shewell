  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// Durable, fixed-window rate limiting.
///
/// Serverless instances do not share memory, so an in-process counter would reset
/// on every cold start and be trivially bypassed by parallel requests. Keeping the
/// counter in Postgres makes the limit hold across every instance.
model RateLimit {
  id          String   @id @default(cuid())
  /// Scope plus subject, e.g. "otp:send:user@example.com" or "login:1.2.3.4".
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
  /// When the current window ends; rows past this are reset or swept.
  expiresAt   DateTime

  @@index([expiresAt])
}

/// Admin capability tiers.
///
/// Previously every AdminUser could do everything, including initiating payouts and
/// creating further admins. Least privilege is the default: a new admin can read,
/// and nothing more, until deliberately promoted.
enum AdminRole {
  /// Full access, including managing other admins.
  SUPER_ADMIN
  /// Day-to-day operations: users, practitioners, sessions, appointments.
  OPERATIONS
  /// Payouts and financial records.
  FINANCE
  /// Blogs, banners, testimonials, categories.
  CONTENT
  /// Read-only.
  SUPPORT
}

/// Append-only record of consequential admin actions.
///
/// Previously the only trace of any admin action was `Payout.initiatedByAdminId`.
/// Approving a practitioner, disabling a customer, changing a colleague's role and
/// deleting content all happened with no record of who or when — which for a
/// product holding identity documents and patient data is not defensible.
///
/// Rows are never updated or deleted by the application.
model AdminAuditLog {
  id         String   @id @default(cuid())
  /// Who acted. Kept as a relation so the actor can be named in the UI.
  actorId    String
  /// Denormalised so the entry still reads correctly if the account is later removed.
  actorEmail String
  /// Dotted event name, e.g. "admin.role_changed" or "doctor.approved".
  action     String
  /// Model the action touched, e.g. "AdminUser".
  entity     String
  entityId   String?
  /// One line a human can read without decoding metadata.
  summary    String?
  /// Before/after values. Must never carry secrets or patient detail.
  metadata   Json?
  createdAt  DateTime @default(now())

  actor AdminUser @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
}
