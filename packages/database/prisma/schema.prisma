model SessionCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  trimester Trimester

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trimester])
}

model Session {
  id    String @id @default(cuid())
  title String
  slug  String @unique

  startAt DateTime
  endAt   DateTime

  price  Decimal       @db.Decimal(10, 2)
  status SessionStatus @default(DRAFT)

  // Media fields
  // Media fields
  thumbnailMediaId String?
  thumbnailMedia   Media?  @relation("SessionThumbnail", fields: [thumbnailMediaId], references: [id])

  banners SessionBanner[]

  // Content fields
  overview String? @db.Text

  // Delivery metadata
  meetingLink String?
  language    String      @default("English")
  type        SessionType @default(ONLINE)

  // Column already exists in the database via migration
  // 20260326171106_add_max_bookings_to_session; the model field was never committed,
  // so every query selecting it failed at runtime.
  maxBookings Int?

  categoryId String
  category   SessionCategory @relation(fields: [categoryId], references: [id])

  registrations SessionRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startAt])
  @@index([type])
  @@index([categoryId])
  @@index([status, startAt])
  @@index([status, type])
}

model SessionBanner {
  id String @id @default(cuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id])

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SessionRegistration {
  id String @id @default(cuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  paymentStatus PaymentStatus @default(PENDING)

  // Payment details
  amountPaid        Decimal? @db.Decimal(10, 2)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  createdAt DateTime @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
  @@index([paymentStatus])
  // Same reason as BookAppointment: the webhook resolves a registration by order id.
  @@index([razorpayOrderId])
}

// ============================================
// DOCTOR EARNING & PAYOUT SYSTEM
// ============================================

enum DoctorPaymentStatus {
  PENDING
  COMPLETED
}

enum PayoutStatus {
  INITIATED
  PROCESSING
  PAID
  FAILED
}

model AppointmentPayment {
  id            String @id @default(cuid())
  appointmentId String @unique
  doctorId      String

  totalAmountInCents   Int
  doctorShareInCents   Int
  platformShareInCents Int

  paymentStatus DoctorPaymentStatus @default(PENDING)

  createdAt DateTime @default(now())

  /// Relations
  appointment BookAppointment            @relation(fields: [appointmentId], references: [id])
  payoutLinks AppointmentPaymentPayout[]

  @@index([doctorId])
  @@index([paymentStatus])
}

/// Admin-controlled payout — doctors do NOT request payouts.
/// Admin selects doctor, enters amount, system creates payout atomically.
model Payout {
  id                 String       @id @default(cuid())
  doctorId           String
  amountInCents      Int
  status             PayoutStatus @default(INITIATED)
  initiatedByAdminId String
  paidAt             DateTime?
  transactionRef     String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  doctor           ProfessionalUser           @relation(fields: [doctorId], references: [id])
  initiatedByAdmin AdminUser                  @relation(fields: [initiatedByAdminId], references: [id])
  payoutLinks      AppointmentPaymentPayout[]

  @@index([doctorId])
  @@index([status])
  @@index([initiatedByAdminId])
}

model AppointmentPaymentPayout {
  id String @id @default(cuid())

  appointmentPaymentId String
  payoutId             String

  amountUsedInCents Int

  /// Relations
  appointmentPayment AppointmentPayment @relation(fields: [appointmentPaymentId], references: [id])
  payout             Payout             @relation(fields: [payoutId], references: [id])

  @@unique([appointmentPaymentId, payoutId])
  @@index([payoutId])
}

