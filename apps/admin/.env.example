# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#
# DATABASE_URL  the connection string the app uses at runtime (may be a pooled URL).
# DIRECT_URL    a direct, non-pooled connection. Prisma Migrate and `prisma validate`
#               use this one. For a plain local Postgres, set it to the same value as
#               DATABASE_URL. It is REQUIRED — `prisma validate`/`migrate` fail without it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shewell"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shewell"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3004"

# Cross-app links
NEXT_PUBLIC_USER="http://localhost:3001"
NEXT_PUBLIC_PROFESSIONAL="http://localhost:3002"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
NEXT_PUBLIC_PLATFORM_FEE=""

# S3 (media, blog images)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_BUCKET=""
NEXT_PUBLIC_AWS_URL_PREFIX=""

# Mail
SENDGRID_API_KEY=""
FROM_EMAIL=""

# Tags every log line so the three apps stay distinguishable in Vercel's
# Runtime Logs. NEXT_PUBLIC_ so the value is inlined into every bundle.
NEXT_PUBLIC_APP_NAME="admin"
