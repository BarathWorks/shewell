# Admin app — copy to `.env` and fill in.
#
# `.env` is the single working env file for this app and is gitignored; this
# example is the only one committed. Keys are grouped to match `src/env.js`, which
# is what actually validates them at build time.
#
# This app deliberately declares fewer variables than the other two: it has no
# Google, Razorpay or cross-portal keys of its own.

# ─── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL  the connection string the app uses at runtime (may be pooled).
# DIRECT_URL    a direct, non-pooled connection, used by Prisma Migrate.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shewell"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shewell"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3004"

# Link back to the patient site (used by the doctor list to open public profiles).
NEXT_PUBLIC_USER="http://localhost:3001"

# ─── S3 (blog images, banners, testimonials, session artwork) ────────────────
# The bucket must accept presigned PUTs from the browser; the app's CSP already
# allows https://*.amazonaws.com in connect-src.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_BUCKET=""
NEXT_PUBLIC_AWS_URL_PREFIX=""

# ─── Mail — SMTP via Nodemailer (packages/mail) ──────────────────────────────
# Used by the admin password-reset action. For Gmail, SMTP_PASSWORD must be a
# 16-character App Password:
# Google Account > Security > 2-Step Verification > App passwords.
# Required in production; optional locally.
SMTP_USER=""
SMTP_PASSWORD=""
# Optional — these default to smtp.gmail.com:465 inside packages/mail.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# Optional — FROM_EMAIL defaults to SMTP_USER.
FROM_EMAIL=""
MAIL_FROM_NAME="SheWell"

# ─── Observability ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="admin"

# ─── Bootstrapping the first administrator ───────────────────────────────────
# Read only by `pnpm --filter @repo/database db:seed:admin`, not by the app.
# The seed refuses to run without an email and never overwrites an existing
# account. Omit the password and a strong one is generated and printed once.
# SEED_ADMIN_EMAIL="ops@yourdomain.com"
# SEED_ADMIN_PASSWORD=""
