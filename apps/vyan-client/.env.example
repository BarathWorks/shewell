# Patient app (vyan-client) — copy to `.env` and fill in.
#
# `.env` is the single working env file for this app and is gitignored; this
# example is the only one committed. Keys are grouped to match `src/env.js`, which
# is what actually validates them at build time.

# ─── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL  the connection string the app uses at runtime (may be pooled).
# DIRECT_URL    a direct, non-pooled connection. Prisma Migrate and `prisma
#               validate` use this one, and it is REQUIRED — they fail without it.
#               For a plain local Postgres, set it to the same value as DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shewell"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shewell"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# ─── Cross-app links ─────────────────────────────────────────────────────────
NEXT_PUBLIC_USER="http://localhost:3001"
NEXT_PUBLIC_PROFESSIONAL="http://localhost:3002"

# ─── Google OAuth + Calendar ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Payments ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Razorpay webhook signing secret (Dashboard > Settings > Webhooks).
# Required in production: the webhook fails closed without it, so payments would
# only confirm when the customer's browser completes the callback.
RAZORPAY_WEBHOOK_SECRET=""

# ─── Pricing (plain numbers, e.g. 18 and 10) ─────────────────────────────────
NEXT_PUBLIC_GST=""
NEXT_PUBLIC_PLATFORM_FEE=""

# ─── Mail — SMTP via Nodemailer (packages/mail) ──────────────────────────────
# For Gmail, SMTP_PASSWORD must be a 16-character App Password:
# Google Account > Security > 2-Step Verification > App passwords.
# Required in production; optional locally, where a failed send prints the OTP
# to the server console instead of blocking sign-in.
SMTP_USER=""
SMTP_PASSWORD=""
# Optional — these default to smtp.gmail.com:465 inside packages/mail.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# Optional — FROM_EMAIL defaults to SMTP_USER.
FROM_EMAIL=""
MAIL_FROM_NAME="SheWell"

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for /api/cron/*. Required in production: those routes refuse to
# run without it. Generate with: openssl rand -hex 32
CRON_SECRET=""

# ─── Observability ───────────────────────────────────────────────────────────
# Tags every log line so the three apps stay distinguishable in Vercel's Runtime
# Logs. NEXT_PUBLIC_ so the value is inlined into every bundle.
NEXT_PUBLIC_APP_NAME="vyan-client"
