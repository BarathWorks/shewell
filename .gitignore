# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
# Backups of env files carry the same live credentials as the originals.
.env.bak
*.env.bak
.env.local.bak
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
vyan/
.env*.local

# Data exports. The trailing slash on the previous entry (`/adminuser.csv/`) made
# it a DIRECTORY pattern, so the file it was meant to ignore was never ignored —
# which is how a live admin password hash reached the repository history.
adminuser.csv
*.csv

# Local Vercel env push config (may carry secret overrides)
scripts/vercel-env.config.json
